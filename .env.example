# Copia este archivo a .env y rellena los valores.
# El .env NUNCA se sube al repositorio.

# --- Base de datos --------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/concesionario_db?serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=carsimport
SPRING_DATASOURCE_PASSWORD=cambia-esta-contrasena

# Solo se usa al levantar la base de datos con docker compose
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-root
MYSQL_DATABASE=concesionario_db

# --- Seguridad ------------------------------------------------------------
# Minimo 32 caracteres. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Origenes permitidos para CORS, separados por comas.
# OJO: aunque el front se sirva bajo el MISMO dominio que la API, hay que poner
# aqui ese dominio. El navegador manda cabecera Origin tambien en las peticiones
# POST del mismo origen, y Spring las rechaza con 403 si no esta en la lista.
# Se noto porque en produccion se podia ver el catalogo (GET, sin Origin) pero
# no iniciar sesion (POST, con Origin).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Ingesta de anuncios (opcional) --------------------------------------
# Sin estos valores la ingesta simplemente no se ejecuta.
APIFY_API_TOKEN=
APIFY_DATASET_ID=
APIFY_AUTOSCOUT_DATASET_ID=
INGESTA_FRECUENCIA=NUNCA
INGESTA_MAX_ITEMS=2000

# --- Desarrollo -----------------------------------------------------------
JPA_SHOW_SQL=false
SERVER_PORT=8087
